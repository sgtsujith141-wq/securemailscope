# SecureMailScope configuration.
#
# Copy to .env for local overrides. .env is gitignored; .env.example is not.
# NEVER put credentials, key material or capture paths containing personal
# data into a file that is tracked by git.
#
# Every setting below is a hard resource ceiling applied while parsing an
# untrusted capture. Reaching one produces an explicit diagnostic and marks
# the affected object truncated -- nothing is ever silently discarded.
# Rationale for each default: docs/threat-model.md.

# Largest capture file accepted at all, checked before parsing (512 MiB).
SECUREMAILSCOPE_MAX_CAPTURE_BYTES=536870912

# Maximum packet records read from one capture.
SECUREMAILSCOPE_MAX_PACKETS=2000000

# Largest single captured packet accepted (256 KiB).
SECUREMAILSCOPE_MAX_PACKET_BYTES=262144

# Total reconstructed application payload retained across all sessions (256 MiB).
SECUREMAILSCOPE_MAX_TOTAL_PAYLOAD_BYTES=268435456

# Reconstructed payload retained per session, both directions summed (16 MiB).
SECUREMAILSCOPE_MAX_SESSION_PAYLOAD_BYTES=16777216

# Connections held open simultaneously.
SECUREMAILSCOPE_MAX_CONCURRENT_SESSIONS=10000

# Connections recorded in total for one capture.
SECUREMAILSCOPE_MAX_TOTAL_SESSIONS=100000

# Stored segment provenance records per direction.
SECUREMAILSCOPE_MAX_SEGMENTS_PER_DIRECTION=200000

# Gap records kept per direction.
SECUREMAILSCOPE_MAX_GAPS_PER_DIRECTION=10000

# Diagnostics emitted per distinct code before the rest are summarised.
SECUREMAILSCOPE_MAX_WARNINGS_PER_CODE=100
